# Stage 1: Build the application
FROM alpine:3.21 AS builder

WORKDIR /usr/src/app

COPY donetick .
COPY config/selfhosted.yaml config/local.yaml ./config/

# Stage 2: Create a smaller runtime image
FROM alpine:3.21

# Install timezone package
RUN apk --no-cache add tzdata

# Install necessary CA certificates
RUN apk --no-cache add ca-certificates libc6-compat

# Copy the binary and config folder from the builder stage
COPY --from=builder /usr/src/app/donetick /daydan
RUN ln -sf /daydan /donetick
COPY --from=builder /usr/src/app/config /config

# Set environment variables
ENV DT_ENV="selfhosted"

# Expose the application port
EXPOSE 2021

# Command to run the application
CMD ["/daydan"]
