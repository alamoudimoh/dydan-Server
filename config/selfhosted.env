DT_NAME=selfhosted
DT_IS_DONE_TICK_DOT_COM=false
DT_IS_USER_CREATION_DISABLED=false
DT_TELEGRAM_TOKEN=
DT_PUSHOVER_TOKEN=
DT_DATABASE_TYPE=sqlite
DT_DATABASE_MIGRATION=true
# JWT secret: leave unset so Dydan generates a strong random secret on first
# boot and persists it in the data directory. Never set this to a static weak
# value like "secret" — the server refuses known-weak secrets at startup.
# DT_JWT_SECRET=
# Lifetime of the short-lived access JWT for browser/app sessions. Sessions
# survive transparently via the HttpOnly refresh cookie, so this can be short.
DT_JWT_ACCESS_TOKEN_TIME=15m
# Legacy /login/legacy integration tokens only; leave as-is unless you rely
# on that endpoint.
DT_JWT_SESSION_TIME=168h
DT_JWT_MAX_REFRESH=168h
# Proxies allowed to set X-Forwarded-* headers (IPs or CIDRs). Loopback
# default covers nginx/Caddy on the same host. See docs/reverse-proxy.md.
DYDAN_TRUSTED_PROXIES=127.0.0.1/8,::1/128
DT_SERVER_PORT=2021
DT_SERVER_READ_TIMEOUT=2s
DT_SERVER_WRITE_TIMEOUT=1s
DT_SERVER_RATE_PERIOD=60s
DT_SERVER_RATE_LIMIT=300
DT_SERVER_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:7926,https://localhost,capacitor://localhost
DT_SERVER_SERVE_FRONTEND=true
DT_SCHEDULER_JOBS_DUE_JOB=30m
DT_SCHEDULER_JOBS_OVERDUE_JOB=3h
DT_SCHEDULER_JOBS_PRE_DUE_JOB=3h
DT_EMAIL_HOST=
DT_EMAIL_PORT=
DT_EMAIL_KEY=
DT_EMAIL_EMAIL=
DT_EMAIL_APP_HOST=
DT_OAUTH2_CLIENT_ID=
DT_OAUTH2_CLIENT_SECRET=
DT_OAUTH2_AUTH_URL=
DT_OAUTH2_TOKEN_URL=
DT_OAUTH2_USER_INFO_URL=
DT_OAUTH2_REDIRECT_URL=
DT_STORAGE_MAX_USER_STORAGE=
DT_STORAGE_MAX_FILE_SIZE=
DT_STORAGE_BUCKET_NAME=
DT_STORAGE_REGION=
DT_STORAGE_BASE_PATH=
DT_STORAGE_ACCESS_KEY=
DT_STORAGE_SECRET_KEY=
DT_STORAGE_ENDPOINT=
# Lifetime of signed media URLs (local HMAC URLs and S3 presigned URLs).
# Clients transparently re-sign expired URLs via /api/v1/files/sign, so this
# can be shortened freely; it is capped at 168h (7d, the AWS SigV4 maximum).
DT_STORAGE_SIGNED_URL_TTL=168h
# Independent signing key for media URLs. Leave unset and Dydan derives a
# storage-specific key from the JWT secret (never the raw JWT key itself).
# Set an explicit value (32+ random characters) to rotate media URLs without
# touching login sessions, e.g. after a suspected link leak:
# DT_STORAGE_MEDIA_SECRET=
# DT_STORAGE_MEDIA_SECRET_FILE=data/media-secret
# Legacy upgrade-window switch: accepts media URLs signed with the pre-6.0
# scheme (raw JWT secret). Safe to disable immediately; such URLs expire
# within 7 days of minting regardless.
DT_STORAGE_ALLOW_LEGACY_MEDIA_SIGNATURES=true
